DEBUG=False

# --- Environment: development | staging | production
ENVIRONMENT=development

# --- Logging
LOG_LEVEL=INFO

# --- Postgres (docker-compose uses host "postgres", local dev uses "localhost")
POSTGRES_USER=market
POSTGRES_PASSWORD=changeme
POSTGRES_DB=market

# Async SQLAlchemy URL. For docker-compose, DATABASE_URL is overridden in the
# compose file to point at the "postgres" service host. Locally, use localhost.
DATABASE_URL="postgresql+asyncpg://market:changeme@localhost:5432/market"

# --- Redis (optional). Set REDIS_ENABLED=False to disable entirely.
REDIS_ENABLED=True
REDIS_URL="redis://localhost:6379/0"

# --- Security (MUST be overridden in production!)
SECRET_KEY=change-me-in-production

# --- CORS
# Comma- or JSON-separated origins. Use explicit origins (your Vue app URL)
# together with CORS_ALLOW_CREDENTIALS=True. A bare "*" requires
# CORS_ALLOW_CREDENTIALS=False.
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=False
